# ==============================================================================
# AgriAI Platform - Environment Configuration Template
# Copy this file to .env and adjust variables as required for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=agripredict
POSTGRES_USER=agriuser
POSTGRES_PASSWORD=agrisecretpassword
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Spring Boot Datasource URL
DB_URL=jdbc:postgresql://localhost:5432/agripredict
DB_USERNAME=agriuser
DB_PASSWORD=agrisecretpassword

# ------------------------------------------------------------------------------
# 2. Redis Configuration (Cache & Rate Limiting)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. MinIO Object Storage Configuration (S3 Compatible)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_RAW=soil-images-raw
MINIO_BUCKET_PROCESSED=soil-images-processed
MINIO_BUCKET_HEATMAPS=gradcam-outputs

# ------------------------------------------------------------------------------
# 4. Spring Boot Gateway & Backend Configuration
# ------------------------------------------------------------------------------
SERVER_PORT=8080
JWT_SECRET=4c9a8f27e1d54b689a74c3e85291b58df8a21d6e4b938c5a27194f6e3a8b2d1c
JWT_EXPIRATION_HOURS=24
ML_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 5. External Weather API (OpenWeatherMap)
# ------------------------------------------------------------------------------
# Get your free key at https://openweathermap.org/api/one-call-3
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ------------------------------------------------------------------------------
# 6. FastAPI ML Service Configuration
# ------------------------------------------------------------------------------
FASTAPI_PORT=8000
MODEL_DIR=./models
DEVICE=cpu

# ------------------------------------------------------------------------------
# 7. Next.js Frontend Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_MAP_DEFAULT_LAT=20.5937
NEXT_PUBLIC_MAP_DEFAULT_LNG=78.9629
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=5
